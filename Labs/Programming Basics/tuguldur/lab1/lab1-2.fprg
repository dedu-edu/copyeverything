<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab1-2"/>
        <attribute name="authors" value="Acer"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 03:40:01 PM"/>
        <attribute name="created" value="QWNlcjtMQVBUT1AtMVVWVE80RUY7MjAyNi0wOS0xNjswMzoyNjoxMSBQTTsyNzQ1"/>
        <attribute name="edited" value="QWNlcjtMQVBUT1AtMVVWVE80RUY7MjAyNi0wOS0xNjswMzo0MDowMSBQTTsxOzI4NDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="givennum, diveder" type="Integer" array="False" size=""/>
            <declare name="isprime" type="Boolean" array="False" size=""/>
            <assign variable="isprime" expression="True"/>
            <input variable="givennum"/>
            <for variable="diveder" start="2" end="givennum-1" direction="inc" step="1">
                <if expression="givennum%diveder==0">
                    <then>
                        <output expression="&quot;not prime&quot;" newline="True"/>
                        <assign variable="isprime" expression="False"/>
                        <breakpoint expression="" always="True"/>
                    </then>
                    <else/>
                </if>
            </for>
            <if expression="isprime">
                <then>
                    <output expression="&quot;prime number&quot;" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
